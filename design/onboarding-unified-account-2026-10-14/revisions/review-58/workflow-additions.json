        "label": "Ко входу",
        "target": "account-entry",
        "variant": "outline"
      }
    ],
    "parent": "account-recovery",
    "layout": "page",
    "note": "Same originating recovery form with a generic acknowledgment, without revealing whether the account exists.",
    "toast": "Инструкции запрошены",
    "form": false
  },
  {
    "id": "password-new",
    "title": "Новый пароль",
    "module": "Account & helping",
    "body": "<p>Задайте новый пароль для этого аккаунта.</p><label class=\"field\">Новый пароль<input name=\"Новый пароль\" type=\"password\" required placeholder=\"\" autocomplete=\"new-password\"></label><label class=\"field\">Повторите пароль<input name=\"Повторите пароль\" type=\"password\" required placeholder=\"\" autocomplete=\"new-password\"></label>",

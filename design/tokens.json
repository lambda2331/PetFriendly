{
  "version": "1.1.0",
  "direction": "Studio",
  "themeDefault": "system",
  "fonts": {
    "heading": "Manrope",
    "body": "Golos Text",
    "wordmark": "Manrope"
  },
  "colors": {
    "light": {
      "background": "#F9F9F6",
      "surface": "#FFFFFF",
      "textPrimary": "#20251E",
      "textSecondary": "#62695C",
      "border": "#E4E7DD",
      "subtle": "#EEF1E7",
      "hero": "#E7EDDA",
      "accent": "#D6ED8A",
      "onAccent": "#253314",
      "error": "#B3261E",
      "sheet": "#FFFFFF"
    },
    "dark": {
      "background": "#141614",
      "surface": "#20231F",
      "textPrimary": "#F4F5EF",
      "textSecondary": "#BBC2B4",
      "border": "#41483C",
      "subtle": "#292F25",
      "hero": "#293121",
      "accent": "#D6ED8A",
      "onAccent": "#253314",
      "error": "#FFB4AB",
      "sheet": "#272C25"
    }
  },
  "typeScale": {
    "display": {
      "size": 32,
      "lineHeight": 1.12,
      "weight": 700
    },
    "heading": {
      "size": 24,
      "lineHeight": 1.2,
      "weight": 700
    },
    "section": {
      "size": 18,
      "lineHeight": 1.3,
      "weight": 600
    },
    "body": {
      "size": 15,
      "lineHeight": 1.5,
      "weight": 400
    },
    "label": {
      "size": 14,
      "lineHeight": 1.35,
      "weight": 500
    },
    "caption": {
      "size": 12,
      "lineHeight": 1.4,
      "weight": 400
    },
    "profileSection": {
      "size": 18,
      "lineHeight": 1.3,
      "weight": 600
    }
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40
  ],
  "radii": {
    "control": 14,
    "card": 24,
    "sheet": 28,
    "avatar": 999
  },
  "layout": {
    "horizontalPadding": 24,
    "minimumTapTarget": 44,
    "iconSize": 20,
    "toolbarHeight": 60
  },
  "motion": {
    "tapMs": 100,
    "tabMs": 180,
    "navigationMs": 220,
    "themeMs": 220,
    "sheetMs": 250,
    "curve": "cubic-bezier(0.2, 0, 0, 1)",
    "reducedMotionMs": 0,
    "pressScale": 0.97
  },
  "surfaces": {
    "object": "surface",
    "overlay": "sheet",
    "supporting": "background",
    "objectBorder": "optional",
    "elevation": "none"
  },
  "media": {
    "identityAspectRatio": 1,
    "communityAspectRatio": 2,
    "fit": "cover",
    "alignment": "center",
    "placeholder": "initials-or-neutral-icon",
    "emptyCommunity": "compact-icon-and-name"
  },
  "typography": {
    "sheetHeading": {
      "family": "Manrope",
      "size": 20,
      "weight": 700,
      "lineHeight": 1.35,
      "letterSpacing": -0.5
    },
    "identityHeading": {
      "family": "Manrope",
      "size": 18,
      "weight": 700,
      "lineHeight": 1.35
    },
    "body": {
      "family": "Golos Text",
      "size": 16,
      "weight": 400,
      "lineHeight": 1.4
    },
    "metadata": {
      "family": "Golos Text",
      "size": 14,
      "weight": 400,
      "lineHeight": 1.45
    },
    "control": {
      "family": "Golos Text",
      "size": 14,
      "weight": 500,
      "lineHeight": 1.4
    },
    "smallLabel": {
      "family": "Golos Text",
      "size": 12,
      "weight": 500,
      "lineHeight": 1.4
    },
    "emptyStateHeading": {
      "family": "Manrope",
      "size": 18,
      "weight": 700,
      "lineHeight": 1.4
    }
  }
}
